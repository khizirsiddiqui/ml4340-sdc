{
  "lane_detection": {
    "module": "vanilla",
    "params": {
      "cut_size": 65,
      "spline_smoothness": 5,
      "gradient_threshold": 14,
      "distance_maxima_gradient": 3,

      "sliding_window": false,
      "sliding_window_margin": 3,
      "sliding_window_nwindows": 5,
      "sliding_window_min_signal": 5
    }
  },
  "longitudinal_controller": {
    "module": "pid",
    "params": {
      "KP": 0.2,
      "KI": 0.05,
      "KD": 0.01,
      "max_sum_error": 1000
    }
  }
}
